# ── Local Python ML service secrets ──────────────────────────────────────────
# Copy this file to moderation-service/.env and fill in the values.

# REQUIRED: Shared secret between the Python service and the Node.js backend.
# Use any long random string (e.g. openssl rand -hex 32).
# Must match MODERATION_API_KEY set in Render.
set MODERATION_API_KEY=QuickPull_Mod_2026_Secret!

set NGROK_PATH=C:\ngrok\ngrok.exe

set NGROK_DOMAIN=spotty-cheddar-unretired.ngrok-free.dev

# OPTIONAL: Number of torch threads for both models (default: half CPU cores)
ML_TORCH_THREADS=

# OPTIONAL: Set to 1 to force smart-reply model load to fail (for testing)
SR_DISABLE=
